# =====================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to `.env` and fill in YOUR values.
# NEVER commit the real `.env` file.
# =====================================

# ---- App ----
NODE_ENV=development
PORT=3000
APP_NAME=FinanceTracker

# ---- Database (PostgreSQL) ----
# Example: postgresql://user:password@localhost:5432/financetracker
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/financetracker

# ---- Redis (caching / fraud score cache) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- Plaid (Banking Integration) ----
# Get these from https://dashboard.plaid.com
PLAID_ENV=sandbox          # sandbox | development | production
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_PUBLIC_KEY=your_plaid_public_key
PLAID_WEBHOOK_URL=

# ---- Fraud Detection ----
# Optional: use a web search provider for recipient verification
FRAUD_CHECK_PROVIDER=internal
FRAUD_SCORE_CACHE_TTL=86400   # seconds (24h)

# ---- Push Notifications ----
EXPO_ACCESS_TOKEN=
EXPO_PROJECT_ID=

# ---- External API Rate Limits ----
API_RATE_LIMIT=100          # requests per window
API_RATE_WINDOW=15          # minutes
